# Copy to .env.local for local development. In Vercel, add these under
# Project → Settings → Environment Variables.
# Both values come from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# iClosed → Zapier intake (server only, never shown in the browser).
# Supabase → Project Settings → API Keys → secret (or legacy service_role) key.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; the same value goes in the Zapier webhook URL.
INTAKE_SECRET=
# The email you sign in with; new recruits are filed under this account.
INTAKE_OWNER_EMAIL=
